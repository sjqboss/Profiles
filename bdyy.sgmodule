#!name=波点音乐
#!desc=过滤波点音乐广告，解锁会员功能（打开软件后切换到个人页面出现会员logo即可使用）｜由 Loon 插件转换，Shadowrocket 专用
#!author=可莉, ZenmoFeiShi, mist-whisper, WeiGiegie
#!homepage=https://github.com/sooyaaabo/Loon/blob/main/README.md
#!icon=https://raw.githubusercontent.com/sooyaaabo/Loon/main/Icon/App-Icon/BodianMusic.png
#!date=2025-09-18

[URL Rewrite]
# 开屏广告
^https:\/\/ad\.tencentmusic\.com\/config\/uni - reject-dict
^https:\/\/bd-api\.kuwo\.cn\/api\/(play|service|advert)\/advert\/ - reject-dict
^https?:\/\/h5s\.kuwo\.cn\/m\/bd_launch_popup\/index - reject

# 搜索 - 横幅推广
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/banner\/ - reject-dict

# VIP活动推广
^https:\/\/bd-api\.kuwo\.cn\/api\/ucenter\/vip\/give\/config\? - reject-dict

# 首页 - 横幅推广 (moduleId=6)
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/home\/module\?.*&moduleId=6 - reject-dict

# 首页 - 低价会员推广文本
^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/lowPriceText\? - reject-dict
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/vipEnter\? - reject-dict

# 弹窗悬浮广告
^https:\/\/bd-api\.kuwo\.cn\/api\/popup\/ - reject-dict
^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/invitation\/swell\/popup\? - reject-dict
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/version\/popup\? - reject-dict
^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/invitation\/assist\/popup\? - reject-dict
^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/h5\/common\/popup\? - reject-dict

[Body Rewrite]
# 全局应用配置 - 删除广告字段 (原 response-body-json-del)
http-response-jq ^https:\/\/bd-api\.kuwo\.cn\/api\/service\/conf\/all\? 'del(.data.groupSign.adStartAppDialog, .data.groupSign.adGuideTest, .data.groupSign.playTips, .data.groupSign.adExitChange, .data.conf.adGuidePopCount, .data.conf.adDownListOpen)'

# P2P传输 - 关闭上传与P2P (原 response-body-json-replace)
http-response-jq ^https:\/\/bd-api\.kuwo\.cn\/api\/service\/conf\/all\? 'if .data.conf.flowControlConfig then (.data.conf.flowControlConfig.uploadEnable = false | .data.conf.flowControlConfig.p2pEnable = false) else . end'

# A/B Test配置 - 删除广告测试项 (原 response-body-json-del)
http-response-jq ^https:\/\/ab-bodian\.kuwo\.cn\/abtest\/ui\/info\? 'del(.data.mapTestInfo.CommentADPosition, .data.mapTestInfo.DiscoverADPosition, .data.mapTestInfo.DownloadAd, .data.mapTestInfo.FreeModVoiceReminder, .data.mapTestInfo.GamesTrans, .data.mapTestInfo.bodianmvdialog, .data.mapTestInfo.MvTryShowAds, .data.mapTestInfo.insert)'

# 全局场景配置 - 删除广告字段 (原 response-body-json-del)
http-response-jq ^https:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/scene\? 'del(.data.iosP2PCacheEnable, .data.warmStartDialog, .data.adsNotFinishVipPop4DayInterval)'

# 全局场景配置 - 关商城入口/限P2P发送 (原 response-body-json-replace)
http-response-jq ^https:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/scene\? '.data.showShopEntry = false | .data.iosP2pEnableSendDataLimit = 1'

# 搜索 - 删除大家都在搜/搜索发现 (原 response-body-json-del)
http-response-jq ^https:\/\/bd-api\.kuwo\.cn\/api\/search\/topic\/word\/list\? 'del(.data.hotTopic, .data.searchFind, .data.globalJumpInfo, .data.hotWord)'

# 首页 - 模块过滤 (原 response-body-json-jq, 表达式原样保留)
http-response-jq ^https:\/\/bd-api\.kuwo\.cn\/api\/service\/home\/index\? '.data.moduleList |= map(select(.type | tostring | (. != "8" and . != "5" and . != "1" and . != "9" and . != "6")))'

# 播放页 - 删除歌曲广告标记 (原 .data.musicList[] |= del(.showAd), 等价改写为 map 形式, 列表为空时不报错)
http-response-jq ^https:\/\/bd-api\.kuwo\.cn\/api\/service\/music\/recommendList\? '.data.musicList |= map(del(.showAd))'

# 评论区 - 删除商品周边 (原 response-body-json-del, 原文 .data.putao 按顶层 data 处理)
http-response-jq ^https:\/\/bd-api\.kuwo\.cn\/api\/comments\/v3\/topInfo\? 'del(.data.putao, .data.bannerVos)'

# 首页 - 听点儿不一样的 (原 .data.resourceList[] |= del(.resource), 等价改写为 map 形式)
http-response-jq ^https:\/\/bd-api\.kuwo\.cn\/api\/service\/resource\/recommend\? '.data.resourceList |= map(del(.resource))'

# 播放页 - 侧边栏沉浸电台banner清空 (原 response-body-json-jq)
http-response-jq ^https:\/\/bd-api\.kuwo\.cn\/api\/voice\/room\/v2\/sidebar '.data = {}'

[Script]
# 解锁会员 (原 Loon http-response 脚本, 脚本本体不变)
波点音乐 = type=http-response, pattern=^https?:\/\/(bd-api\.kuwo\.cn\/api\/(ucenter\/users\/(pub|login)|play\/(advert\/info|music\/v2\/(audioUrl|checkRight))|service\/(home\/module|music\/download\/(info|config)|global\/config\/(scene|vipEnter)|banner\/positions)|advert\/(config|free\/config)|search\/topic\/word\/list|pay\/(vip\/(lowPriceText|invitation\/(assist\/popup|swell))|audition\/url|sp\/actVip))|us\.l\.qq\.com\/exapp\?adposcount), script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/bdyy.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% 111.30.171.170, 39.156.12*.*, 39.156.121.20, 39.156.121.21, 39.156.123.46, ab-bodian.kuwo.cn, ad.tencentmusic.com, bd-api.kuwo.cn, bd-api.kuwo.com, bodianimgcdn.kuwo.cn, h5app.kuwo.cn, h5s.kuwo.cn, *.kuwo.*, *.l.qq.com
